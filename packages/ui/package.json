{
  "name": "@libs/ui",
  "version": "0.0.1",
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "module": "fesm2022/libs-ui.mjs",
  "typings": "types/libs-ui.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/libs-ui.d.ts",
      "default": "./fesm2022/libs-ui.mjs"
    },
    "./button": {
      "types": "./types/libs-ui-button.d.ts",
      "default": "./fesm2022/libs-ui-button.mjs"
    },
    "./core": {
      "types": "./types/libs-ui-core.d.ts",
      "default": "./fesm2022/libs-ui-core.mjs"
    }
  },
  "type": "module"
}